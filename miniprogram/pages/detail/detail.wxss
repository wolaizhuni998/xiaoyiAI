/* ===== 商品详情 · 通栏图区 + 单列信息 ===== */
.page {
  min-height: 100vh;
  padding-bottom: 0;
}

/* 主视觉：通栏 1:1，不套圆角、不加投影 */
.hero {
  width: 100%;
  height: 750rpx;
  background-color: #f4f4f6;
  overflow: hidden;
}

.hero-swiper {
  width: 100%;
  height: 100%;
}

.hero-img {
  width: 100%;
  height: 100%;
  display: block;
}

.hero-empty {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.hero-ic {
  width: 132rpx;
  height: 132rpx;
  opacity: 0.55;
}

/* 正文区 */
.body {
  padding: 0 40rpx;
}

.prow {
  display: flex;
  align-items: baseline;
  padding-top: 32rpx;
}

.price {
  font-size: 44rpx;
  font-weight: 700;
  color: #1d1d1f;
  letter-spacing: -0.5rpx;
}

.nego {
  margin-left: 16rpx;
  font-size: 24rpx;
  color: var(--tone, #007aff);
}

.title {
  margin-top: 12rpx;
  font-size: 34rpx;
  font-weight: 600;
  line-height: 1.45;
  color: #1d1d1f;
}

.meta {
  margin-top: 10rpx;
  font-size: 24rpx;
  color: #8e8e93;
}

/* 纯色底上的分割线：用半透明黑，比固定浅灰更稳 */
.hr {
  height: 1rpx;
  background-color: rgba(0, 0, 0, 0.07);
  margin: 28rpx 0 0;
}

/* 卖家行 */
.seller {
  display: flex;
  align-items: center;
  padding: 28rpx 0;
}

.s-av {
  flex: none;
  width: 76rpx;
  height: 76rpx;
  border-radius: 50%;
  background-color: #f2f2f7;
  color: #6e6e73;
  font-size: 30rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
}

.s-main {
  flex: 1;
  min-width: 0;
  margin-left: 20rpx;
}

.s-name {
  font-size: 29rpx;
  font-weight: 500;
  color: #1d1d1f;
}

.s-sub {
  margin-top: 4rpx;
  font-size: 23rpx;
  color: #8e8e93;
}

/* 区块 */
.sec {
  padding: 34rpx 0 0;
}

.desc {
  margin-top: 14rpx;
  font-size: 28rpx;
  line-height: 1.75;
  color: #48484a;
}

.place {
  display: flex;
  align-items: center;
  margin-top: 14rpx;
}

.place-ic {
  width: 32rpx;
  height: 32rpx;
  margin-right: 10rpx;
}

.place-t {
  font-size: 28rpx;
  color: #1d1d1f;
}

.place-note {
  margin-top: 8rpx;
  font-size: 23rpx;
  color: #8e8e93;
  line-height: 1.5;
}

.pad {
  height: 200rpx;
}

/* ===== 底部悬浮操作栏：液态玻璃（通栏，不需要左右色散） ===== */
.bar-wrap {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 14rpx 40rpx calc(env(safe-area-inset-bottom) + 20rpx);
  background-color: rgba(255, 255, 255, 0.50);
  -webkit-backdrop-filter: saturate(180%) blur(24px) brightness(1.06);
  backdrop-filter: saturate(180%) blur(24px) brightness(1.06);
  box-shadow:
    inset 0 1px 0 rgba(255, 255, 255, 0.98),
    inset 0 -1px 0 rgba(0, 0, 0, 0.04);
}

.bar {
  display: flex;
  align-items: center;
}

.fav {
  flex: none;
  width: 112rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 2rpx;
}

.fav:active {
  opacity: 0.55;
}

.fav-ic {
  width: 40rpx;
  height: 40rpx;
}

.fav-t {
  font-size: 21rpx;
  color: #6e6e73;
}

.contact-btn {
  flex: 1;
  height: 92rpx;
  margin-left: 24rpx;
  border-radius: 46rpx;
  background-color: var(--tone, #007aff);
  color: #ffffff;
  font-size: 29rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
}

.contact-btn:active {
  opacity: 0.82;
}

.desc{white-space:pre-wrap;word-break:break-all}

/* 让实物图与正文形成清晰的阅读区 */
.hero{width:calc(100% - 48rpx);height:640rpx;margin:24rpx;border-radius:30rpx;background:#fff}.hero-img{object-fit:contain}.body{padding:0 32rpx}.prow{padding-top:16rpx}.price{font-size:48rpx;color:var(--tone)}.title{font-size:36rpx;line-height:1.5}.meta{line-height:1.6;color:#737b87}.sec{margin-top:20rpx;padding:28rpx;background:#fff;border-radius:26rpx;font-size:27rpx;line-height:1.75}.sec .t-h2{font-size:29rpx}.desc{font-size:27rpx;color:#495461;word-break:break-word;overflow-wrap:break-word}.place-note{color:#737b87;font-size:23rpx;line-height:1.7}.seller{padding:24rpx 0}.s-sub{color:#737b87}.bar-wrap{background:rgba(255,255,255,.94);padding-left:24rpx;padding-right:24rpx}.contact-btn{height:88rpx;border-radius:24rpx}.fav{min-height:88rpx}.pad{height:240rpx}
