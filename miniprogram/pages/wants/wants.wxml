<!-- 求物品：发布意向 + 需求池单列列表 -->
<nav-bar />
<view class="page tone-{{tone}}">
  <view class="body">
    <view class="head dev d1">
      <view class="t-h1">求物品</view>
      <view class="head-s">写下你想找的东西，同学看到会来找你</view>
    </view>

    <!-- 发布意向：无卡片外框，输入行 + 类目 + 按钮 -->
    <view class="compose dev d2">
      <input class="c-in" placeholder="想求购的教材、数码、生活好物" placeholder-style="color:#b0b0b6" value="{{kw}}" bindinput="onKw" />
      <view class="c-cats">
        <view class="c-chip {{selCat === item ? 'on' : ''}}" wx:for="{{cats}}" wx:key="*this" data-c="{{item}}" bindtap="pickCat">{{item}}</view>
      </view>
      <view class="c-act">
        <view class="c-btn" bindtap="publish">{{editing ? '保存修改' : '发布求购'}}</view>
        <view class="c-cancel" wx:if="{{editing}}" bindtap="cancelEdit">取消</view>
      </view>
    </view>

    <!-- 需求池 -->
    <view class="sec-title dev d3">
      <text class="t-h2">同学在找</text>
      <text class="sec-n">{{list.length}} 条</text>
    </view>

    <view class="list dev d3">
      <view class="w-row" wx:for="{{list}}" wx:key="id" data-d="{{item}}" bindtap="editCard">
        <view class="w-title">{{item.title}}</view>
        <view class="w-meta">{{item.budget}} · {{item.cond}} · {{item.place}}</view>
        <view class="w-time">{{item.time}}</view>
      </view>
      <view class="empty" wx:if="{{!list.length}}">还没有人发布求购</view>
    </view>
    <view class="pad"></view>
  </view>

  <ink-tabbar id="tabs" current="/pages/wants/wants" bind:tab="onTab" bind:go="onTab" />
</view>
