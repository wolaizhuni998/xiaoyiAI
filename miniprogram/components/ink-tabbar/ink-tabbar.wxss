  background-image: url('data:image/svg+xml;utf8,<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="%231D1D1F" stroke="%231D1D1F" stroke-width="1"><path d="M12 2L2 10h3v10a1 1 0 0 0 1 1h4v-6h4v6h4a1 1 0 0 0 1-1V10h3L12 2z"/></svg>');
