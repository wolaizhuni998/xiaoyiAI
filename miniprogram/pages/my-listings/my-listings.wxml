<view class="body"><view class="title">我的发布</view><view class="note">本地演示：下方按钮模拟审核员处理，不代表真实平台审核或校园认证。</view><view wx:if="{{!list.length}}">暂无发布记录</view><view class="card" wx:for="{{list}}" wx:key="id"><image src="{{item.photos[0]}}" mode="aspectFit"/><view>{{item.title}}</view><view>{{item.school}} · {{item.campus}}</view><view>{{item.price}} · {{item.label}}</view><view wx:if="{{item.aiReport}}"><view>AI审核：{{item.aiReport.decision === 'pass' ? '初审低风险' : '需补充材料或复核'}}</view><view wx:for="{{item.aiReport.reasons}}" wx:for-item="reason" wx:key="*this">{{reason}}</view><view wx:if="{{item.aiReport.quality}}">AI参考评分 {{item.aiReport.quality.score}} / 100 · {{item.aiReport.quality.comment}}</view></view><view wx:if="{{item.reviewReason}}">审核说明：{{item.reviewReason}}</view><button wx:if="{{item.status === 'rejected' || item.status === 'offline'}}" data-id="{{item.id}}" bindtap="edit">修改信息与照片后重新提交</button><button wx:if="{{item.status === 'approved' || item.status === 'pending'}}" data-id="{{item.id}}" bindtap="offline">下架商品</button><view wx:if="{{demo && item.status === 'pending'}}"><button data-id="{{item.id}}" data-ok="yes" bindtap="review">模拟审核通过</button><button data-id="{{item.id}}" data-ok="no" bindtap="review">模拟审核拒绝</button></view></view></view>