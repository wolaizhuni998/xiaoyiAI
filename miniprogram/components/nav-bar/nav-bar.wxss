/* 自绘毛玻璃顶栏（液态玻璃）
   组件有样式隔离，全局 .glass 不生效，这里自带一份配方。
   要点：几乎不着色的半透明白 + 大半径模糊采样背后内容 + 边缘透镜厚度 + 极轻色散。 */

.nav-ph {
  width: 100%;
}

.nav {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  z-index: 900;
  box-sizing: border-box;
  background-color: rgba(255, 255, 255, 0.45);
  -webkit-backdrop-filter: saturate(180%) blur(24px) brightness(1.06);
  backdrop-filter: saturate(180%) blur(24px) brightness(1.06);
  /* 透镜厚度 + 色散，底部一道界线替代 border */
  box-shadow:
    inset 0 1px 0 rgba(255, 255, 255, 0.98),
    inset 0 -1px 0 rgba(0, 0, 0, 0.06),
    inset 1px 0 0 rgba(255, 92, 122, 0.12),
    inset -1px 0 0 rgba(92, 160, 255, 0.14);
}

/* 顶部受光面 */
.nav::before {
  content: '';
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  pointer-events: none;
  background: linear-gradient(
    180deg,
    rgba(255, 255, 255, 0.32) 0%,
    rgba(255, 255, 255, 0.05) 46%,
    rgba(255, 255, 255, 0) 100%
  );
}

.nav-row {
  position: relative;
  height: 44px;
  display: flex;
  align-items: center;
  z-index: 1;
}

.nav-back {
  position: absolute;
  left: 0;
  top: 0;
  width: 88rpx;
  height: 44px;
  display: flex;
  align-items: center;
  justify-content: center;
}

.nav-back-hv {
  opacity: 0.45;
}

.nav-chev {
  width: 18rpx;
  height: 18rpx;
  border-left: 3rpx solid #1d1d1f;
  border-bottom: 3rpx solid #1d1d1f;
  transform: rotate(45deg);
  margin-left: -4rpx;
}

/* 右侧留 200rpx 给右上角胶囊，标题不会撞上去 */
.nav-title {
  flex: 1;
  margin: 0 200rpx 0 88rpx;
  font-size: 32rpx;
  font-weight: 600;
  color: #1d1d1f;
  text-align: center;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}
