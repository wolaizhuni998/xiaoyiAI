page{background:#f4f6f8}.body{padding:40rpx 32rpx calc(60rpx + env(safe-area-inset-bottom))}.title{font-size:44rpx;font-weight:600;color:#25313d}.note{color:#737b87;margin:20rpx 0 28rpx;font-size:24rpx;line-height:1.75}.card{padding:28rpx;margin-bottom:24rpx;background:#fff;border:1rpx solid #edf0f3;border-radius:28rpx;line-height:1.8;font-size:26rpx;color:#495461;overflow:hidden}.card>image{width:100%;height:320rpx;border-radius:20rpx;background:#f4f6f8;margin-bottom:16rpx}.card>view{margin-top:10rpx;word-break:break-word}.card>view:first-of-type{font-size:30rpx;font-weight:600;color:#25313d}.card button{margin-top:18rpx;padding:8rpx 20rpx;font-size:25rpx;background:#f0f4f8;color:#34516d;border-radius:18rpx;line-height:2.3}.card button:active{opacity:.75}
