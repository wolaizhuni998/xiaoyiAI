/* ===== 底部悬浮液态玻璃导航栏 =====
   白底只着 0.40：玻璃要"透"，背后的卡片和底色缝隙才能透过来看见。
   着色一重（>0.6）就变成不透明白条，模糊再对也看不出来。
   blur 负责把透过的内容糊开；安卓不支持 blur 时就是一层浅白纱，依然透明。

   液态层（.blob）：一颗水珠压在玻璃上，静止时缩在选中项下方，
   长按 260ms 后放大并跟手，按速度横向拉伸、纵向压扁，松手弹回最近的格子。
   只用一颗不用两颗 —— 两个半透明圆叠在一起，交界处一定露出更深的弧线，反而像两个球。 */
.tabs {
  position: fixed;
  left: 28rpx;
  right: 28rpx;
  bottom: calc(env(safe-area-inset-bottom) + 20rpx);
  height: 112rpx;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: space-around;
  z-index: 999;

  /* 圆角取半高，做满胶囊（原来 40rpx 是圆角矩形，不是胶囊） */
  border-radius: 56rpx;
  background-color: rgba(255, 255, 255, 0.40);
  -webkit-backdrop-filter: saturate(180%) blur(28px) brightness(1.08);
  backdrop-filter: saturate(180%) blur(28px) brightness(1.08);
  box-shadow:
    /* 浮起 */
    0 14rpx 36rpx -6rpx rgba(0, 0, 0, 0.22),
    0 2rpx 8rpx rgba(0, 0, 0, 0.04),
    /* 透镜厚度 */
    inset 0 2rpx 0 rgba(255, 255, 255, 0.98),
    inset 0 -2rpx 0 rgba(255, 255, 255, 0.40),
    /* 色散 */
    inset 2rpx 0 0 rgba(255, 92, 122, 0.12),
    inset -2rpx 0 0 rgba(92, 160, 255, 0.14);
}

/* 顶部受光面 */
.tabs::before {
  content: '';
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  border-radius: inherit;
  pointer-events: none;
  background: linear-gradient(
    180deg,
    rgba(255, 255, 255, 0.40) 0%,
    rgba(255, 255, 255, 0.06) 40%,
    rgba(255, 255, 255, 0) 66%,
    rgba(255, 255, 255, 0.08) 100%
  );
}

/* ===== 水珠 ===== */
/* 裁切层：水珠被框在胶囊里，拉长时不会漏到条外面
   （不能给 .tabs 直接 overflow:hidden，中间那颗上凸的发布钮要露出来） */
.blob-clip {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  border-radius: inherit;
  overflow: hidden;
  pointer-events: none;
  z-index: 0;
}

.blob {
  position: absolute;
  top: 50%;
  left: 0;
  width: 80rpx;
  height: 80rpx;
  margin-left: -40rpx;
  margin-top: -40rpx;
  border-radius: 50%;
  pointer-events: none;
  transition: opacity 0.22s ease;
}

/* 主体：白玻璃上压一层主题色，换调色盘水珠跟着变色。
   白的比例压到 0.78 —— 太实（0.95）就又是"白球落在白玻璃上"，看不出边界。 */
.blob.core {
  background-color: rgba(255, 255, 255, 0.80);
  box-shadow:
    inset 0 2rpx 0 rgba(255, 255, 255, 0.9),
    inset 0 -10rpx 18rpx -6rpx rgba(96, 116, 158, 0.26);
  /* 跟手时不加过渡，否则会拖出延迟；吸附时由 .snap 给弹性 */
}

.blob.core::after {
  content: '';
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  border-radius: 50%;
  background-color: var(--tone, #007aff);
  opacity: 0.20;
}

/* 尾巴：删掉了。两个半透明圆叠在一起，交界处一定露出一圈更深的弧线，
   反而像两个球。液态只靠一颗：长按胀大 + 按速度横向拉伸/纵向压扁 + 松手弹回。 */

/* 松手后回到格子：带一点过冲，像水滴落回水洼 */
.tabs.snap .blob.core {
  transition: transform 0.52s cubic-bezier(0.34, 1.42, 0.64, 1), opacity 0.22s ease;
}

/* 发布页：水珠整个让位给中间那颗实心圆钮 */
.tabs.noblob .blob {
  opacity: 0;
}

.tab {
  flex: 1;
  height: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 4rpx;
  position: relative;
  z-index: 2;
  transition: opacity 0.2s ease;
}

.tab:active {
  opacity: 0.55;
}

/* 长按进入液态后，按压反馈会让整格发灰，此时关掉 */
.tabs.liquid .tab:active {
  opacity: 1;
}

.tico {
  position: relative;
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: transform 0.34s cubic-bezier(0.34, 1.42, 0.64, 1);
}

/* 选中项图标被水珠托起，略微放大 */
.tab.on .tico {
  transform: scale(1.06);
}

.tabs.liquid .tab.on .tico {
  transform: scale(1.14);
}

/* 水珠滑过哪一格，哪一格的图标就被顶起来一点（像水波托了一下） */
.tab.near .tico {
  transform: translateY(-4rpx) scale(1.16);
}

.tab.near .tlab {
  color: #1d1d1f;
  font-weight: 600;
}

.tlab {
  font-size: 23rpx;
  color: #8e8e93;
  font-weight: 500;
  letter-spacing: 0.5rpx;
  transition: color 0.2s ease;
}

/* 激活态：文字近黑（图标保持单色，避免与强调色打架） */
.tab.on .tlab {
  color: #1d1d1f;
  font-weight: 600;
}

/* 中间发布键：实底圆，保留上凸 */
.tab.mid {
  overflow: visible;
}

.tab.mid .tico {
  width: 82rpx;
  height: 82rpx;
  border-radius: 50%;
  margin-top: -30rpx;
  background-color: var(--tone, #007aff);
  box-shadow: 0 8rpx 18rpx rgba(0, 0, 0, 0.16);
  /* 实心圆钮不参与水珠的放大 */
  transform: none;
}

/* 液态态下也别把圆钮顶大 */
.tabs.liquid .tab.mid .tico {
  transform: none;
}

.tab.mid:active .tico {
  opacity: 0.8;
}

.tab.mid .tlab {
  display: none;
}

/* ===== SVG 图标（1.8 描边，未选灰 / 选中实底） ===== */
.ico-svg {
  width: 40rpx;
  height: 40rpx;
  background-size: contain;
  background-repeat: no-repeat;
  background-position: center;
}

